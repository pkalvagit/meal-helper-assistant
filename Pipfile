[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# LLM Providers
langchain = ">=0.1.0"
langchain-core = ">=0.1.0"
langchain-community = ">=0.0.20"
langchain-anthropic = ">=0.1.0"
langchain-openai = ">=0.1.0"
anthropic = ">=1.7"
openai = ">=1.0"

# Core dependencies
pydantic = ">=2.0"
pydantic-settings = ">=2.0"
python-dotenv = ">=1.0"
pyyaml = ">=6.0"

# Web scraping & data
requests = ">=2.32"
beautifulsoup4 = ">=4.12"
playwright = ">=1.40"
markdownify = ">=0.11"
pypdf = ">=6.0"
Pillow = ">=10.0"

# Data processing
pandas = ">=2.0"

# CLI
typer = ">=0.9"
rich = ">=13.0"

# Optional: Observability
langsmith = ">=0.1.0"

[dev-packages]
# Testing
pytest = ">=7.4"
pytest-asyncio = ">=0.21"

[requires]
python_version = "3.11"
